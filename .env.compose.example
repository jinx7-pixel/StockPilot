# =============================================================================
# StockPilot — variables for docker-compose.prod.yml
#
# 1. Copy this file next to docker-compose.prod.yml as `.env.compose` and fill
#    it in. `.env.compose` is local-only and must never be committed.
#
# 2. A FILE LIKE THIS IS NOT SECURE SECRET STORAGE. It is plain text on disk
#    in your home directory, readable by anything running as your user and
#    easily swept up by backup tooling. It is acceptable for a local rehearsal
#    and for development. For production, inject these names from the platform's
#    secret store instead — Swarm secrets, Kubernetes Secrets, AWS/GCP/Azure
#    secret managers — and never write them into a file that leaves the host.
#
# 3. Two roles are required, and they are NOT interchangeable:
#
#      DB_ADMIN_*     owns the schema and is used ONLY by the one-shot migration
#                     job. Needs CREATE / ALTER / ownership rights.
#      PG_RUNTIME_*   is the restricted role the API connects as. It holds only
#                     SELECT / INSERT / UPDATE / DELETE on the twelve runtime
#                     tables and must never be given DDL rights.
#
#    Do not reuse `backend/.env.runtime` inside a container: that file is the
#    local `npm run dev:local` mechanism and is gitignored on purpose.
# =============================================================================

# --- Database name (shared) ---------------------------------------------------
PGDATABASE=stockpilot

# --- Migration / owner role (compose service `migrate` ONLY) ------------------
DB_ADMIN_USER=stockpilot_owner
DB_ADMIN_PASSWORD=CHANGE_ME_local_rehearsal_only

# --- Restricted API runtime role (compose service `api`) ----------------------
PG_RUNTIME_USER=stockpilot_app
PG_RUNTIME_PASSWORD=CHANGE_ME_local_rehearsal_only

# --- Connection --------------------------------------------------------------
# Local rehearsal reaches the `db` service by its Compose name.
PGHOST=db
PGPORT=5432
PGPOOL_MAX=10

# Local rehearsal only: the postgres container serves no TLS.
# PRODUCTION: use verify-full against managed PostgreSQL.
PGSSLMODE=disable

# Used only by the migration job. Same caveat as PGSSLMODE.
MIGRATE_PGSSLMODE=disable

# --- HTTP ---------------------------------------------------------------------
# The only host port published by the stack.
FRONTEND_PORT=8080

# --- LOCAL REHEARSAL ONLY --------------------------------------------------
# The rehearsal database has no TLS and the stack is served over plain HTTP, so
# NODE_ENV cannot be `production` here: assertProductionSafe() requires a
# TLS-enforcing PGSSLMODE, a secure cookie and https CORS origins, and refuses
# to start otherwise.
#
# PRODUCTION values, to be set together, never one at a time:
#   NODE_ENV=production
#   PGSSLMODE=verify-full
#   COOKIE_SECURE=true
#   CORS_ORIGINS=https://your-frontend.example.com
NODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:8080

# TRUST_PROXY is deliberately NOT here. It is set to 1 in the compose file
# because it is a property of the topology — exactly one Nginx hop — not a
# deployment choice. Setting it to `true` would let any client forge
# X-Forwarded-For and therefore its own rate-limit bucket.

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info