# ------------------------------------------------------------------
# StockPilot Frontend — local environment template
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your machine:
#   cp .env.example .env.local
#
# `.env` and `.env.local` are git-ignored and must NEVER be committed.
# Only variables prefixed with `VITE_` are exposed to the browser bundle,
# so never prefix a secret with `VITE_`.
# ------------------------------------------------------------------

# Base URL of the StockPilot API.
# Leave empty to use the Vite dev-server proxy (see vite.config.ts), which
# forwards `/api/*` to the backend and keeps CORS out of the way locally.
VITE_API_BASE_URL=

# Target used by the dev-server proxy (and by `npm run preview`).
VITE_API_PROXY_TARGET=http://localhost:4000

# Dev / preview server ports
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# ------------------------------------------------------------------
# Reserved for later milestones — leave blank until implemented.
# ------------------------------------------------------------------
# VITE_APP_NAME=StockPilot
