# ------------------------------------------------------------------
# StockPilot API — local environment template
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for your machine:
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Never place real
# passwords, connection strings, API keys or tokens in this file's
# committed counterpart or anywhere else in source control.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server default is http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=debug

# Number of reverse-proxy hops to trust when deriving the client IP.
# Leave at 0 when running directly. In production behind one proxy set 1;
# getting this wrong makes every client share a single rate-limit bucket.
TRUST_PROXY=0

# ------------------------------------------------------------------
# Authentication (opaque session token in an HTTP-only cookie)
# ------------------------------------------------------------------
# Name of the session cookie. The token is never exposed to JavaScript
# and is never written to localStorage.
SESSION_COOKIE_NAME=sp_session

# Session lifetime in days.
SESSION_TTL_DAYS=7

# Secure cookie flag. Defaults to true in production and false elsewhere,
# so local HTTP development works without weakening production.
# Override only if you need a specific value in a given environment.
# COOKIE_SECURE=true

# SameSite policy. Use `lax` while the app and API share a site
# (subdomains included). A cross-site deployment needs `none`, which
# browsers only accept together with the Secure flag.
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------
# PostgreSQL (connection only — schema is created via migrations)
# ------------------------------------------------------------------
# Option A: single connection string (takes precedence when set).
# DATABASE_URL=postgresql://stockpilot:change-me@localhost:5432/stockpilot

# Option B: discrete libpq-style variables.
PGHOST=localhost
PGPORT=5432
PGDATABASE=stockpilot
PGUSER=stockpilot
# PGPASSWORD=change-me
PGSSLMODE=disable

# Connection pool tuning
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=5000

# Database used by the automated test suite. MUST differ from PGDATABASE —
# the tests truncate tables freely. The suite creates it if missing and
# applies the committed migrations to it.
TEST_PGDATABASE=stockpilot_test

# ------------------------------------------------------------------
# Migrations (node-pg-migrate) — used only by `npm run migration:*`
# ------------------------------------------------------------------
# Schema that migrations run against, and that holds the tracking table.
PGSCHEMA=public

# Table recording which migrations have been applied. Changing this after
# migrations have run will orphan the existing history — leave it alone.
PGMIGRATIONS_TABLE=pgmigrations

# Directory holding migration files, relative to the backend package root.
# Only change this if migrations move to a different location.
MIGRATIONS_DIR=../database/migrations

# ------------------------------------------------------------------
# Reserved for later milestones — leave blank until implemented.
# ------------------------------------------------------------------
# JWT_SECRET=
# OPENAI_API_KEY=
