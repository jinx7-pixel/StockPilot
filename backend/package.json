{
  "name": "stockpilot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockPilot API — Inventory Intelligence Platform",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run typecheck:app && npm run typecheck:migrations",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:migrations": "tsc -p ../database/tsconfig.json --noEmit",
    "lint": "eslint . && npm run lint:migrations",
    "lint:migrations": "cd ../database && eslint --config eslint.config.js .",
    "migration:create": "tsx src/db/migrate.ts create",
    "migration:up": "tsx src/db/migrate.ts up",
    "migration:down": "tsx src/db/migrate.ts down",
    "migration:redo": "tsx src/db/migrate.ts redo",
    "migration:status": "tsx src/db/migrate.ts status"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.20.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
