# Normalize line endings so Windows / macOS / Linux checkouts agree.
* text=auto eol=lf

# Windows-only files stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep these exactly as authored / binary
.gitattributes text eol=lf
.gitignore text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfiles: npm writes LF
package-lock.json text eol=lf

# SQL migrations must keep LF regardless of the contributor's OS
*.sql text eol=lf
